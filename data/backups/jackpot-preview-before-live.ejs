<th><i class="fa-solid fa-calendar-days"></i> THỜI GIAN</th>
</tr>
</thead>
<tbody id="jackpotHistoryTableBody">
<!-- Populated dynamically via JS -->
</tbody>
</table>
</div>
<div class="jackpot-history-footer">
<span class="history-live-indicator"><span class="pulse-green-dot"></span> Đang đồng bộ dữ liệu thời gian thực toàn Server</span>
<button class="btn-refresh-history" onclick="renderJackpotHistoryTable()" type="button">
<i class="fa-solid fa-rotate-right"></i> Làm Mới
                    </button>
</div>
</div>
</div>
</div>
<script src="/assets/arena-dashboard/jackpot-preview.js?v=1" defer></script>
