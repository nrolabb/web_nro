<div class="dashboard-modal hidden" id="jackpotHistoryModal" onclick="if(event.target === this) closeJackpotHistoryModal()">
<div class="modal-box jackpot-modal-box jackpot-history-modal-box">
<div class="modal-header jackpot-modal-header">
<h2><i class="fa-solid fa-clock-rotate-left text-gold"></i> LỊCH SỬ TRÚNG THƯỞNG TOÀN SEVER</h2>
<span class="close-btn" onclick="closeJackpotHistoryModal()">×</span>
</div>
<div class="modal-body jackpot-history-body">
<!-- Filter Tabs -->
<div class="jackpot-history-tabs">
<button class="history-tab-btn active" onclick="filterJackpotHistory('all', this)" type="button">
<i class="fa-solid fa-list-ul"></i> TẤT CẢ (<span id="historyCountAll">8</span>)
                    </button>
<button class="history-tab-btn tab-grand" onclick="filterJackpotHistory('grand', this)" type="button">
<i class="fa-solid fa-crown"></i> GRAND
                    </button>
<button class="history-tab-btn tab-major" onclick="filterJackpotHistory('major', this)" type="button">
<i class="fa-solid fa-fire"></i> MAJOR
                    </button>
<button class="history-tab-btn tab-minor" onclick="filterJackpotHistory('minor', this)" type="button">
<i class="fa-solid fa-bolt-lightning"></i> MINOR
                    </button>
<button class="history-tab-btn tab-mini" onclick="filterJackpotHistory('mini', this)" type="button">
<i class="fa-solid fa-star"></i> MINI
                    </button>
</div>
<!-- History Table / Records List -->
<div class="jackpot-history-table-wrap">
<table class="jackpot-history-table">
