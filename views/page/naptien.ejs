<%-include("../partials/dashboard-meta.ejs", {title: "Donate"})%>

<body class="dashboard-site">
  <%-include("../partials/head.ejs")%>
  <style>
    #donnetConsentModal { z-index: 1400; }
    #donnetConsentModal .donnet-consent-box { max-height: calc(100dvh - 32px); overflow-y: auto; touch-action: pan-y; }
    #donnetConsentModal .btn-feature-action { margin: 0; }
    .bank-info {
      display: block;
      margin: 0 auto 30px;
      max-width: 500px;
      padding: 20px;
      border: 2px solid #f8b52e;
      border-radius: 10px;
      background-color: rgba(0, 0, 0, 0.6);
    }
    .amount-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 15px;
      margin-bottom: 20px;
    }
    .amount-btn {
      padding: 15px 10px;
      border: 2px solid #f8b52e;
      background-color: transparent;
      color: #f8b52e;
      border-radius: 8px;
      font-family: Pony, sans-serif;
      font-size: 18px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .amount-btn:hover, .amount-btn.active {
      background-color: #f8b52e;
      color: #9d441c;
    }
    .pay-btn {
      width: 100%;
      padding: 15px;
      background-color: #f8b52e;
      color: #9d441c;
      border: none;
      border-radius: 8px;
      font-family: Pony, sans-serif;
      font-size: 20px;
      cursor: pointer;
      margin-top: 10px;
      font-weight: bold;
    }
    .pay-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    /* Popup Styles */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 1100;
      justify-content: center;
      align-items: center;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-content {
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      border: 3px solid #f8b52e;
      max-width: 400px;
      width: 90%;
      position: relative;
      max-height: calc(100dvh - 32px);
      overflow-y: auto;
    }
    .close-btn {
      position: absolute;
      top: 10px; right: 15px;
      font-size: 30px;
      cursor: pointer;
      color: #333;
      font-weight: bold;
      line-height: 1;
    }
    .transfer-info {
      background: transparent;
      color: #333;
      box-shadow: none;
      padding: 0;
      text-align: left;
    }
    .transfer-info p {
      margin: 8px 0;
      font-size: 16px;
    }
    .qrcode {
      margin: 15px auto 0;
      max-width: 250px;
    }
    .qrcode img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 8px;
    }
  </style>

  <main class="main-body-container">
    <section class="donnet-view-panel">
      <h1 class="section-hexagon-title">DONATE ỦNG HỘ</h1>
      <div class="donnet-card-container">
        <div class="donnet-thanks-banner">Cảm ơn bạn đã đồng hành cùng Arena Thần Rồng! Donate lần đầu <%= promotion.firstTopupBonus %>%, các lần sau <%= promotion.regularTopupBonus %>%.</div>
        <div class="donnet-form-area">
          <div class="donnet-form-group"><label for="donnetUsernameInput" class="donnet-field-label">Tài khoản nhận điểm</label><input id="donnetUsernameInput" class="donnet-text-input" value="<%= user[0].username %>" readonly></div>
          <div class="donnet-form-group"><label for="donnetAmountSelect" class="donnet-field-label">Mức Donate</label><div class="donnet-select-wrapper"><select id="donnetAmountSelect" class="donnet-select-input">
            <% 
              const topupAmounts = [10000, 20000, 50000, 100000, 200000, 500000, 1000000];
              const getGiftcodeTag = (amount) => amount >= 1000000 ? `GIFTCODE${amount / 1000000}M` : `GIFTCODE${amount / 1000}k`;
              topupAmounts.forEach(amount => { 
            %>
              <option value="<%= amount %>" <%= amount === 50000 ? 'selected' : '' %>><%= amount.toLocaleString('vi-VN') %> VNĐ -> <%= Math.floor(amount * promotion.multiplier).toLocaleString('vi-VN') %> Điểm + <%= getGiftcodeTag(amount) %></option>
            <% }) %>
          </select><i class="fa-solid fa-chevron-down select-caret-icon"></i></div></div>
          <p id="donate-rate" class="donnet-qr-subtitle"><%= promotion.isFirstTopup ? 'Donate lần đầu' : 'Donate các lần sau' %>: nhận <%= promotion.isFirstTopup ? promotion.firstTopupBonus : promotion.regularTopupBonus %>% điểm.</p>
          <button class="btn-create-qr" id="btn-pay">Tạo mã QR</button>
        </div>
        <div class="donnet-qr-subtitle"><i class="fa-solid fa-qrcode"></i> Chuyển khoản đúng nội dung để được cộng điểm tự động</div>
        <div class="donnet-history-container">
          <h2 class="donnet-history-heading">Lịch sử Donate của TK: <%= user[0].username %></h2>
          <div class="donnet-table-responsive"><table class="donnet-history-table"><thead><tr><th>Mã giao dịch</th><th>Mức Donate</th><th>Trạng thái</th></tr></thead><tbody>
            <% if (typeof donationHistory === 'undefined' || donationHistory === null) { %><tr><td colspan="3">Chưa tải được lịch sử. Vui lòng thử lại sau.</td></tr>
            <% } else if (!donationHistory.length) { %><tr><td colspan="3">Chưa có giao dịch Donate.</td></tr><% } else { donationHistory.forEach(row => { %>
              <tr><td><%= row.transaction_id %></td><td class="history-amount"><%= Number(row.amount).toLocaleString('vi-VN') %> VND</td><td><%= row.is_credited ? 'Thành công' : 'Chưa cộng điểm' %></td></tr>
            <% }); } %>
          </tbody></table></div>
        </div>
      </div>
    </section>
  </main>

    <div id="donnetConsentModal" class="dashboard-modal hidden" role="dialog" aria-modal="true" aria-labelledby="donnet-consent-title" aria-describedby="donnet-consent-desc">
        <div class="modal-box donnet-consent-box">
            <div class="donnet-consent-content">
                <div class="donnet-consent-icon-wrap">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3 id="donnet-consent-title" class="donnet-consent-title">XÁC NHẬN DONNET TỰ NGUYỆN</h3>
                <p id="donnet-consent-desc" class="donnet-consent-desc">
                    Vui lòng tích chọn xác nhận dưới đây để tiếp tục tạo mã QR
                </p>

                <label class="modal-voluntary-pill" for="modalConsentCheckbox">
                    <input type="checkbox" id="modalConsentCheckbox" class="modal-consent-cb">
                    <span class="modal-consent-text">Hãy bảo đảm hành động này là hoàn toàn tự nguyện</span>
                </label>

                <div class="donnet-consent-actions-row">
                    <button id="btnProceedDonnetQr" class="btn-feature-action" style="flex: 2;" disabled>
                        <i class="fa-solid fa-circle-check"></i> XÁC NHẬN
                    </button>
                    <button class="btn-feature-action" style="flex: 1;" id="btnCancelDonnetQr">
                        HỦY
                    </button>
                </div>
            </div>
        </div>
    </div>


  <!-- Popup -->
  <div class="modal-overlay" id="payment-modal" data-bank="<%= paymentAccount.bankBin %>" data-account="<%= paymentAccount.accountNumber %>" data-name="<%= paymentAccount.accountName %>" data-purpose="<%= paymentAccount.purpose %>">
    <div class="modal-content">
      <span class="close-btn" id="close-modal">&times;</span>
      <div class="transfer-info">
        <h2 style="font-family: Pony; text-align: center; color: #9d441c; margin-bottom: 15px;">Thông tin chuyển khoản</h2>
        <p style="font-family: Pony;">Ngân hàng: <b style="color: #9d441c;"><%=paymentAccount.bankName%></b></p>
        <p style="font-family: Pony;">Số tài khoản: <b style="color: #9d441c;"><%=paymentAccount.accountNumber%></b></p>
        <p style="font-family: Pony;">Chủ tài khoản: <b style="color: #9d441c;"><%=paymentAccount.accountName%></b></p>
        <p style="font-family: Pony;">Mức Donate: <b id="display-amount" style="color: red; font-size: 18px;">0</b> VND</p>
        <p style="font-family: Pony;">Nội dung: <b style="color: red; font-size: 18px;"><%=paymentAccount.purpose%></b></p>
        
        <p style="font-family: Pony; color: red; text-align: center; font-size: 14px; margin-top: 15px;">Mở App Ngân Hàng để quét mã QR Donate</p>
        <div class="qrcode">
          <img id="qr-image" src="" alt="Mã QR thanh toán">
        </div>
      </div>
    </div>
  </div>

  <!-- Success Popup -->
  <div class="modal-overlay" id="success-modal">
    <div class="modal-content" style="text-align: center;">
      <span class="close-btn" id="close-success-modal">&times;</span>
      <h2 style="font-family: Pony; color: #4CAF50; margin-bottom: 15px;">Donate thành công!</h2>
      <p style="font-family: Pony; font-size: 18px;">Cảm ơn bạn đã Donate.</p>
      <p style="font-family: Pony; font-size: 18px;">Số dư hiện tại của bạn là: <b id="new-balance-display" style="color: red; font-size: 22px;">0</b> điểm</p>
      <button id="btn-success-ok" style="margin-top: 15px; padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 8px; font-family: Pony; font-size: 18px; cursor: pointer;">Đóng</button>
    </div>
  </div>

  <script>
    let selectedAmount = Number(document.getElementById('donnetAmountSelect').value);
    const payBtn = document.getElementById('btn-pay');
    const modal = document.getElementById('payment-modal');
    const closeModal = document.getElementById('close-modal');
    const successModal = document.getElementById('success-modal');
    const closeSuccessModal = document.getElementById('close-success-modal');
    const btnSuccessOk = document.getElementById('btn-success-ok');
    
    let initialDonationTotal = <%= Number(user[0].tongnap || 0) %>;
    let initialBalance = <%= user[0].vnd || 0 %>;
    let paymentCheckInterval = null;
    
    document.getElementById('donnetAmountSelect').addEventListener('change', event => {
      selectedAmount = Number(event.target.value);
    });
    window.addEventListener('pagehide', stopPaymentCheck);

    function startPaymentCheck() {
      if (paymentCheckInterval) clearInterval(paymentCheckInterval);
      
      paymentCheckInterval = setInterval(async () => {
        try {
          const response = await fetch('/api/check-balance');
          const data = await response.json();
          if (data.success && Number(data.tongnap) > initialDonationTotal) {
            // Thanh toán thành công
            clearInterval(paymentCheckInterval);
            initialDonationTotal = Number(data.tongnap);
            // Update the next Donate preview immediately after the first payment.
            const regularRate = <%= promotion.regularTopupBonus %>;
            const getGiftcodeTag = (amount) => amount >= 1000000 ? `GIFTCODE${amount / 1000000}M` : `GIFTCODE${amount / 1000}k`;
            for (const option of document.getElementById('donnetAmountSelect').options) {
              const amount = Number(option.value);
              option.textContent = `${amount.toLocaleString('vi-VN')} VNĐ -> ${Math.floor(amount * regularRate / 100).toLocaleString('vi-VN')} Điểm + ${getGiftcodeTag(amount)}`;
            }
            document.getElementById('donate-rate').textContent = `Donate các lần sau: nhận ${regularRate}% điểm`;
            initialBalance = data.vnd; // Cập nhật số dư
            
            // Đóng popup QR
            modal.classList.remove('active');
            
            // Hiển thị popup thành công
            document.getElementById('new-balance-display').innerText = Number(data.vnd).toLocaleString('vi-VN');
            successModal.classList.add('active');

            // Cập nhật trên header menu
            const headerBalance = document.getElementById('header-user-vnd');
            if (headerBalance) {
              headerBalance.innerText = Number(data.vnd).toLocaleString('vi-VN');
            }
          }
        } catch (error) {
          console.error("Lỗi khi kiểm tra thanh toán:", error);
        }
      }, 3000); // Kiểm tra mỗi 3 giây
    }

    function stopPaymentCheck() {
      if (paymentCheckInterval) {
        clearInterval(paymentCheckInterval);
        paymentCheckInterval = null;
      }
    }

    const consentModal = document.getElementById('donnetConsentModal');
    const consentCheckbox = document.getElementById('modalConsentCheckbox');
    const consentProceed = document.getElementById('btnProceedDonnetQr');
    const consentCancel = document.getElementById('btnCancelDonnetQr');

    function closeDonnetConsentModal(restoreFocus = true) {
      consentModal.classList.add('hidden');
      document.body.classList.remove('modal-open');
      consentCheckbox.checked = false;
      consentProceed.disabled = true;
      if (restoreFocus) payBtn.focus();
    }
    payBtn.addEventListener('click', () => {
      if (selectedAmount <= 0) return;
      consentCheckbox.checked = false;
      consentProceed.disabled = true;
      consentModal.classList.remove('hidden');
      document.body.classList.add('modal-open');
      consentCheckbox.focus();
    });
    consentCheckbox.addEventListener('change', () => {
      consentProceed.disabled = !consentCheckbox.checked;
    });
    consentCancel.addEventListener('click', () => closeDonnetConsentModal());
    consentModal.addEventListener('click', event => {
      if (event.target === consentModal) closeDonnetConsentModal();
    });
    consentModal.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeDonnetConsentModal();
      if (event.key === 'Tab') {
        if (event.shiftKey && document.activeElement === consentCheckbox) {
          event.preventDefault(); consentCancel.focus();
        } else if (!event.shiftKey && document.activeElement === consentCancel) {
          event.preventDefault(); consentCheckbox.focus();
        }
      }
    });
    consentProceed.addEventListener('click', () => {
      if (!consentCheckbox.checked || consentProceed.disabled) return;
      closeDonnetConsentModal(false);
      if (selectedAmount > 0) {
        document.getElementById('display-amount').innerText = Number(selectedAmount).toLocaleString('vi-VN');
        
        const bankBin = modal.dataset.bank;
        const accountNumber = modal.dataset.account;
        const accountName = modal.dataset.name;
        const purpose = modal.dataset.purpose;
        
        const qrUrl = `https://img.vietqr.io/image/${bankBin}-${accountNumber}-compact2.png?amount=${selectedAmount}&addInfo=${encodeURIComponent(purpose)}&accountName=${encodeURIComponent(accountName)}`;
        
        document.getElementById('qr-image').src = qrUrl;
        modal.classList.add('active');
        
        // Bắt đầu kiểm tra thanh toán
        startPaymentCheck();
      }
    });

    closeModal.addEventListener('click', () => {
      modal.classList.remove('active');
      stopPaymentCheck();
    });
    
    closeSuccessModal.addEventListener('click', () => {
      successModal.classList.remove('active');
    });

    btnSuccessOk.addEventListener('click', () => {
      successModal.classList.remove('active');
    });
  </script>



</body>
</html>
