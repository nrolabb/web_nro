  /* DISGUISE SELECTOR MODAL */
  function openDisguiseSelectorModal(target) {
    currentDisguiseTarget = target || 'add';
    document.getElementById('disguiseSelectorModal').style.display = 'flex';
  }

  function closeDisguiseSelectorModal() {
    document.getElementById('disguiseSelectorModal').style.display = 'none';
  }

  function filterDisguiseItems() {
    var search = (document.getElementById('disguiseSearchInput').value || '').toLowerCase().trim();
    var rows = document.querySelectorAll('.disguise-row');
    rows.forEach(function(row) {
      var name = row.getAttribute('data-name');
      var id = row.getAttribute('data-id');
      if (!search || name.includes(search) || id.includes(search)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function selectDisguiseItem(head, body, leg, name) {
    if (currentDisguiseTarget === 'add') {
      document.getElementById('add_outfit_head').value = head;
      document.getElementById('add_outfit_body').value = body;
      document.getElementById('add_outfit_leg').value = leg;
      showToast('Đã chọn Cải trang cho Boss Mới: ' + name, 'success');
      triggerAddCanvasUpdate();
    } else if (currentDisguiseTarget === 'edit') {
      document.getElementById('edit_outfit_head').value = head;
      document.getElementById('edit_outfit_body').value = body;
      document.getElementById('edit_outfit_leg').value = leg;
      showToast('Đã chọn Cải trang cho Boss đang sửa: ' + name, 'success');
      triggerEditCanvasUpdate();
    }
    closeDisguiseSelectorModal();
  }

