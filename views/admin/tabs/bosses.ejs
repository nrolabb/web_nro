          <!-- Forms Section -->
          <h4 style="color: var(--text-primary); margin: 15px 0 8px 0; font-size: 15px; border-left: 3px solid var(--primary-color); padding-left: 8px;">Danh sách Dạng Biến Hình (boss_form) & Kỹ năng (boss_skill)</h4>
          <div style="display: flex; flex-direction: column; gap: 10px;">
    `;

    if (data.forms && data.forms.length > 0) {
      data.forms.forEach(function(f) {
        var formSkills = data.skills ? data.skills.filter(function(s) { return s.form_id === f.id; }) : [];
        html += `
          <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <strong style="color: var(--primary-color);">Dạng ${f.form_order + 1}: ${f.name}</strong>
              <span style="font-size: 12px; font-family: monospace; color: #28a745;">HP: ${new Intl.NumberFormat('vi-VN').format(f.hp_min)} ~ ${new Intl.NumberFormat('vi-VN').format(f.hp_max)} | Dame: ${new Intl.NumberFormat('vi-VN').format(f.dame)}</span>
            </div>
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 6px;">
              Trang phục Part: Head <strong>${f.outfit_head}</strong>, Body <strong>${f.outfit_body}</strong>, Leg <strong>${f.outfit_leg}</strong> | Balo ${f.outfit_bag}, Aura ${f.outfit_aura}, Eff ${f.outfit_eff}
            </div>
            ${f.text_start ? `<div style="font-size: 12px; font-style: italic; color: #ffc107;">💬 Ra trận: "${f.text_start}"</div>` : ''}
            
            <div style="margin-top: 8px; padding-top: 6px; border-top: 1px dashed rgba(255,255,255,0.1);">
              <div style="font-size: 12px; font-weight: 600; margin-bottom: 4px;">Kỹ năng sử dụng:</div>
              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                ${formSkills.length > 0 ? formSkills.map(function(s) {
                  return `<span class="badge" style="background: rgba(255,255,255,0.08); font-size: 11px;">${s.skill_name || ('Skill ID ' + s.skill_id)} (Cấp ${s.skill_level}) - ${s.cooldown}ms</span>`;
                }).join('') : '<span style="font-size: 11px; color: var(--text-muted);">Không có chiêu thức đặc thù</span>'}
              </div>
            </div>
          </div>
        `;
      });
    } else {
      html += `<div style="color: var(--text-muted); font-size: 13px;">Chưa cấu hình boss_form</div>`;
    }

    html += `
          </div>
        </div>

        <!-- Canvas Preview for Detail Modal -->
        <div style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); padding: 12px; border-radius: 8px; text-align: center;">
          <h4 style="margin: 0 0 10px 0; color: var(--primary-color); font-size: 13px;">Hình Dáng Nhân Vật (Canvas)</h4>
          <div style="width: 100%; height: 230px; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); border-radius: 6px;">
            <canvas id="detailBossCanvas" width="180" height="220" style="width: 180px; height: 220px;"></canvas>
          </div>
        </div>
      </div>

      <!-- Map & Rewards Grid -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 10px;">
        <!-- Maps -->
        <div>
          <h4 style="color: var(--text-primary); margin: 0 0 8px 0; font-size: 15px; border-left: 3px solid #17a2b8; padding-left: 8px;">Map Xuất Hiện (boss_map)</h4>
          <div style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; max-height: 160px; overflow-y: auto;">
    `;

    if (data.maps && data.maps.length > 0) {
      html += `<ul style="margin: 0; padding-left: 18px; font-size: 13px;">`;
      data.maps.forEach(function(m) {
        html += `<li><strong>${m.map_name || ('Map ID ' + m.map_id)}</strong> (ID: ${m.map_id}) ${m.zone_id !== -1 ? '- Khu ' + m.zone_id : '- Ngẫu nhiên khu'}</li>`;
      });
      html += `</ul>`;
    } else {
      html += `<div style="font-size: 12px; color: var(--text-muted);">Tất cả map (hoặc ngẫu nhiên)</div>`;
    }

    html += `
          </div>
        </div>

        <!-- Rewards -->
        <div>
          <h4 style="color: var(--text-primary); margin: 0 0 8px 0; font-size: 15px; border-left: 3px solid #28a745; padding-left: 8px;">Phần Thưởng Rớt Đồ (boss_reward)</h4>
          <div style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; max-height: 160px; overflow-y: auto;">
    `;

    if (data.rewards && data.rewards.length > 0) {
      html += `<div style="display: flex; flex-direction: column; gap: 6px; font-size: 12px;">`;
      data.rewards.forEach(function(r) {
        var optsList = [];
        try {
          optsList = typeof r.item_options === 'string' ? JSON.parse(r.item_options) : (r.item_options || []);
        } catch(e) {}
        var optStr = '';
        if (Array.isArray(optsList) && optsList.length > 0) {
          optStr = '<div style="font-size: 11px; color: var(--text-muted); margin-top: 2px; display: flex; flex-wrap: wrap; gap: 4px;">' + optsList.map(function(o) {
            var optName = itemOptionDict[o.id] || ('Option #' + o.id);
            return `<span class="badge" style="background: rgba(255,255,255,0.06); font-size: 10px; font-weight: normal;">${escapeJsString(optName)}: +${o.param}</span>`;
          }).join('') + '</div>';
        }

        html += `
          <div style="border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 6px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span>🎁 <strong>${r.item_name || ('Item ID ' + r.item_id)}</strong> (SL: ${r.quantity_min}~${r.quantity_max})</span>
              <span style="color: #28a745; font-weight: 600;">Tỉ lệ: ${r.rate}%</span>
            </div>
            ${optStr}
          </div>
        `;
      });
      html += `</div>`;
    } else {
      html += `<div style="font-size: 12px; color: var(--text-muted);">Chưa cấu hình boss_reward</div>`;
    }

    html += `
          </div>
        </div>
      </div>

      <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
        <button class="btn btn-primary" onclick="closeBossDetailsModal(); openEditBossModal(${t.id});">
          ✏️ Chỉnh Sửa Boss Này
        </button>
        <button class="btn btn-ghost" onclick="closeBossDetailsModal()">Đóng Chi Tiết</button>
      </div>
    `;

    container.innerHTML = html;

    if (firstForm) {
      setTimeout(function() {
        renderBossCanvas('detailBossCanvas', firstForm.outfit_head, firstForm.outfit_body, firstForm.outfit_leg);
      }, 100);
    }
  }

  function closeBossDetailsModal() {
    document.getElementById('bossDetailsModal').style.display = 'none';
  }

  /* CANVAS SPRITE RENDERER SYSTEM (Trục tọa độ xOy & Part index) */
  async function renderBossCanvas(canvasId, headPart, bodyPart, legPart) {
    var canvas = document.getElementById(canvasId);
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Gốc tọa độ xOy trên Canvas (Tâm trục X, Sàn trục Y)
    var originX = Math.round(canvas.width / 2);
    var groundY = canvas.height - 35;

    // Bóng sàn chân ở gốc tọa độ
    ctx.beginPath();
    ctx.ellipse(originX, groundY, 32, 9, 0, 0, 2 * Math.PI);
    ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
    ctx.fill();

    var h = Number(headPart);
    var b = Number(bodyPart);
    var l = Number(legPart);

    if ((isNaN(h) || h < 0) && (isNaN(b) || b < 0) && (isNaN(l) || l < 0)) {
      ctx.fillStyle = '#999';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Chưa chọn Part/Cải trang', originX, canvas.height / 2);
      return;
    }

    var res = await adminApi('get-part-icons', { head: h, body: b, leg: l });
    if (!res.success || !res.parts) return;

    var parts = res.parts;

    var loadImg = function(iconId) {
      return new Promise(function(resolve) {
        if (iconId === undefined || iconId === null || iconId < 0) return resolve(null);
        var img = new Image();
        img.onload = function() { resolve(img); };
        img.onerror = function() { resolve(null); };
        img.src = '/api/icon/' + iconId + '.png';
      });
    };

    var legImg = parts.leg ? await loadImg(parts.leg.iconId) : null;
    var bodyImg = parts.body ? await loadImg(parts.body.iconId) : null;
    var headImg = parts.head ? await loadImg(parts.head.iconId) : null;

    // Xóa nền & vẽ lại trục tọa độ xOy
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Trục xOy mờ định vị
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(originX, 10);
    ctx.lineTo(originX, canvas.height - 10);
    ctx.moveTo(10, groundY);
    ctx.lineTo(canvas.width - 10, groundY);
    ctx.stroke();

    // Bóng sàn chân
    ctx.beginPath();
    ctx.ellipse(originX, groundY, 32, 9, 0, 0, 2 * Math.PI);
    ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
    ctx.fill();

    // Ghép 3 bộ phận Leg (chân), Body (thân), Head (đầu) lên hệ trục xOy
    // Tỉ lệ x4: Ảnh icon từ x4 có độ phân giải gấp 4 lần hệ tọa độ 1x trong DATA
    // Trục Oy hướng xuống dưới (Màn hình Canvas): Phía trên đường sàn Ox mang giá trị âm (-dy)
    // Quy tắc cộng offset: Head (-13, +34), Body (-9, +16), Leg (-8, +10)
    var SCALE = 4;

    // 1. Chân (Leg - type 2: vị trí 1, dx + -8, dy + 10)
    if (legImg && parts.leg) {
      var legDx = ((parts.leg.dx || 0) - 8) * SCALE;
      var legDy = ((parts.leg.dy || 0) + 10) * SCALE;
      var legX = originX + legDx;
      var legY = groundY - legDy; // Phía trên Ox có giá trị Y nhỏ hơn (âm so với Ox)
      ctx.drawImage(legImg, Math.round(legX), Math.round(legY));
    }

    // 2. Thân (Body - type 1: vị trí 1, dx + -9, dy + 16)
    if (bodyImg && parts.body) {
      var bodyDx = ((parts.body.dx || 0) - 9) * SCALE;
      var bodyDy = ((parts.body.dy || 0) + 16) * SCALE;
      var bodyX = originX + bodyDx;
      var bodyY = groundY - bodyDy; // Phía trên Ox có giá trị Y nhỏ hơn (âm so với Ox)
      ctx.drawImage(bodyImg, Math.round(bodyX), Math.round(bodyY));
    }

    // 3. Đầu (Head - type 0: vị trí 0, dx + -13, dy + 34)
    if (headImg && parts.head) {
      var headDx = ((parts.head.dx || 0) - 13) * SCALE;
      var headDy = ((parts.head.dy || 0) + 34) * SCALE;
      var headX = originX + headDx;
      var headY = groundY - headDy; // Phía trên Ox có giá trị Y nhỏ hơn (âm so với Ox)
      ctx.drawImage(headImg, Math.round(headX), Math.round(headY));
    }
  }
</script>
