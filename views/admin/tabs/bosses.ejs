    var qMax = Number(document.getElementById('edit_reward_q_max').value) || qMin;
    var rate = Number(document.getElementById('edit_reward_rate').value) || 100;
    var evPt = Number(document.getElementById('edit_reward_event_point').value) || 0;
    var actPt = Number(document.getElementById('edit_reward_active_point').value) || 0;

    if (!Number.isInteger(itemId) || itemId <= 0) {
      showToast('Vui lòng chọn vật phẩm rớt hợp lệ!', 'warning');
      return;
    }

    editBossRewardList.push({
      item_id: itemId,
      quantity_min: qMin,
      quantity_max: qMax,
      rate: rate,
      event_point: evPt,
      active_point: actPt,
      item_options: []
    });

    renderEditRewardRows();
    select.value = '';
  }

