<!-- Bosses Management Tab (SQL Tập Trung & Thêm / Sửa Boss) -->

<!-- Header Statistics Cards -->
<% 
  var templateList = (typeof bossTemplates !== 'undefined' && bossTemplates) ? bossTemplates : [];
  var disguiseList = (typeof disguiseItems !== 'undefined' && disguiseItems) ? disguiseItems : [];
  var liveBossList = (typeof bosses !== 'undefined' && bosses) ? bosses : [];

  var totalTemplates = templateList.length;
  var enabledTemplates = templateList.filter(function(b) { return b.enabled === 1 || b.enabled === true; }).length;
  var disabledTemplates = totalTemplates - enabledTemplates;
  var taskBosses = templateList.filter(function(b) { return b.type === 'TASK'; }).length;
  var eventBosses = templateList.filter(function(b) { return b.type === 'EVENT'; }).length;
%>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 20px;">
  <div class="panel-card" style="padding: 15px; border-left: 4px solid var(--primary-color);">
    <div style="font-size: 13px; color: var(--text-muted);">Tổng Boss Template</div>
    <div style="font-size: 24px; font-weight: 700; color: var(--text-primary); margin-top: 5px;"><%= totalTemplates %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Quản lý trong CSDL MySQL</div>
  </div>

  <div class="panel-card" style="padding: 15px; border-left: 4px solid #28a745;">
    <div style="font-size: 13px; color: var(--text-muted);">Đang Bật Spawn</div>
    <div style="font-size: 24px; font-weight: 700; color: #28a745; margin-top: 5px;"><%= enabledTemplates %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Sẵn sàng xuất hiện trong game</div>
  </div>

  <div class="panel-card" style="padding: 15px; border-left: 4px solid var(--danger);">
    <div style="font-size: 13px; color: var(--text-muted);">Đang Tắt Spawn</div>
    <div style="font-size: 24px; font-weight: 700; color: var(--danger); margin-top: 5px;"><%= disabledTemplates %></div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Tạm ngưng tạo tự động</div>
  </div>

  <div class="panel-card" style="padding: 15px; border-left: 4px solid #17a2b8;">
    <div style="font-size: 13px; color: var(--text-muted);">Boss Task & Event</div>
    <div style="font-size: 24px; font-weight: 700; color: #17a2b8; margin-top: 5px;">
      <%= taskBosses %> <span style="font-size: 14px; color: var(--text-muted); font-weight: normal;">Task</span> / <%= eventBosses %> <span style="font-size: 14px; color: var(--text-muted); font-weight: normal;">Event</span>
    </div>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Phân loại theo cơ chế</div>
  </div>
</div>

<!-- Section: Gọi Boss Tới Máy Chủ -->
<div class="panel-card" style="max-width: 750px; margin: 0 auto 25px auto;">
  <div class="panel-card-body">
    <h2 style="color: var(--text-primary); margin-bottom: 8px; text-align: center; font-size: 20px;">Gọi Boss Tới Máy Chủ</h2>
    <p style="color: var(--text-muted); text-align: center; margin-bottom: 20px; font-size: 13px;">
      Chọn Boss từ danh sách CSDL hoặc nhập ID để lập tức tạo Boss vào game mà không cần khởi động lại Server.
    </p>
    
    <div style="display: grid; grid-template-columns: 1fr 180px; gap: 15px; align-items: end;">
      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" style="font-size: 13px; font-weight: 600;">Chọn Boss từ CSDL</label>
        <select id="bossSelect" class="form-input" onchange="updateCustomId()" style="padding: 10px;">
          <option value="">-- Chọn Boss từ Template SQL --</option>
          <% 
            var templateGroups = {};
            templateList.forEach(function(bt) {
              var grp = bt.sub_type || bt.type || 'Khác';
              if (!templateGroups[grp]) templateGroups[grp] = [];
              templateGroups[grp].push(bt);
            });
          %>
          <% Object.keys(templateGroups).forEach(function(grp) { %>
            <optgroup label="<%= grp %> (<%= templateGroups[grp].length %> boss)">
              <% templateGroups[grp].forEach(function(bt) { %>
                <option value="<%= bt.id %>"><%= bt.name %> (ID: <%= bt.id %>) - [<%= bt.type %>]</option>
              <% }); %>
            </optgroup>
          <% }); %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" style="font-size: 13px; font-weight: 600;">Hoặc nhập ID Boss</label>
        <input type="number" id="customBossId" class="form-input" placeholder="Ví dụ: -1822" style="padding: 10px;">
      </div>
    </div>

    <div style="text-align: center; margin-top: 20px;">
      <button class="btn btn-primary" onclick="spawnBoss()" style="width: 100%; padding: 12px; font-size: 15px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
          <line x1="12" y1="22.08" x2="12" y2="12"/>
        </svg>
        Gọi Boss Vào Game
      </button>
    </div>
  </div>
</div>

<!-- Section: Quản Lý Cấu Hình Boss (SQL boss_template) -->
<div class="toolbar" style="margin-bottom: 15px;">
  <div class="toolbar-left" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
    <button class="btn btn-success" onclick="openAddBossModal()" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Thêm Boss Mới
    </button>

    <div class="search-box" style="min-width: 220px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" class="form-input" placeholder="Tìm tên, ID hoặc Nhóm Boss..." id="bossSearchInput" onkeyup="filterBossTable()">
    </div>

    <select id="bossTypeFilter" class="form-input" onchange="filterBossTable()" style="width: auto; padding: 6px 12px; font-size: 13px;">
      <option value="">-- Tất cả loại Boss --</option>
      <option value="NORMAL">NORMAL (Thường)</option>
      <option value="TASK">TASK (Nhiệm vụ)</option>
      <option value="EVENT">EVENT (Sự kiện)</option>
      <option value="DUNGEON">DUNGEON (Phó bản)</option>
      <option value="PHOBAN">PHOBAN (Phó bản đặc thù)</option>
      <option value="MINI">MINI (Mini Boss)</option>
      <option value="FINAL">FINAL (Trùm cuối)</option>
    </select>

    <select id="bossStatusFilter" class="form-input" onchange="filterBossTable()" style="width: auto; padding: 6px 12px; font-size: 13px;">
      <option value="">-- Tất cả trạng thái --</option>
      <option value="1">Đang BẬT Spawn</option>
      <option value="0">Đang TẮT Spawn</option>
    </select>
  </div>

  <div class="toolbar-right">
    <span class="result-count">Hiển thị: <strong id="visibleBossCount"><%= totalTemplates %></strong> / <%= totalTemplates %> Boss Template</span>
  </div>
</div>

<div class="panel-card" style="margin-bottom: 25px;">
  <div class="panel-card-body" style="padding: 0;">
    <div class="admin-table-wrapper">
      <table class="admin-table" id="bossTemplateTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Tên Boss & Dạng</th>
            <th>Chỉ số (HP / Sát thương)</th>
            <th>Loại & Nhóm</th>
            <th>Hồi sinh / Tự rời</th>
            <th>Trạng thái Spawn</th>
            <th style="text-align: center;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if (templateList && templateList.length > 0) { %>
            <% templateList.forEach(function(b) { %>
              <tr class="boss-row" 
                  data-name="<%= (b.name || '').toLowerCase() %>" 
                  data-id="<%= b.id %>" 
                  data-subtype="<%= (b.sub_type || '').toLowerCase() %>" 
                  data-type="<%= b.type %>" 
                  data-enabled="<%= b.enabled ? '1' : '0' %>">
                <td style="font-family: 'JetBrains Mono', monospace; font-weight: 600;"><%= b.id %></td>
                <td>
                  <div style="font-weight: 600; color: var(--primary-color); font-size: 14px;"><%= b.name %></div>
                  <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                    <span class="badge" style="background: rgba(255,255,255,0.08); font-weight: normal;"><%= b.form_count || 1 %> Dạng (Form)</span>
                    <% if (b.require_task_id) { %>
                      <span class="badge badge-warning" style="font-size: 10px;">NV ID: <%= b.require_task_id %></span>
                    <% } %>
                  </div>
                </td>
                <td style="font-size: 12px; font-family: 'JetBrains Mono', monospace;">
                  <% if (b.min_hp) { %>
                    <div style="color: #28a745;">HP: <%= formatNumber(b.min_hp) %><% if (b.max_hp && b.max_hp !== b.min_hp) { %> ~ <%= formatNumber(b.max_hp) %><% } %></div>
                    <div style="color: var(--danger);">Dame: <%= formatNumber(b.min_dame) %><% if (b.max_dame && b.max_dame !== b.min_dame) { %> ~ <%= formatNumber(b.max_dame) %><% } %></div>
                  <% } else { %>
                    <span style="color: var(--text-muted);">Theo dạng form</span>
                  <% } %>
                </td>
                <td>
                  <% 
                    var typeBadgeClass = 'badge-purple';
                    if (b.type === 'TASK') typeBadgeClass = 'badge-warning';
                    else if (b.type === 'EVENT') typeBadgeClass = 'badge-success';
                    else if (b.type === 'MINI') typeBadgeClass = 'badge';
                    else if (b.type === 'PHOBAN' || b.type === 'DUNGEON') typeBadgeClass = 'badge-danger';
                  %>
                  <span class="badge <%= typeBadgeClass %>"><%= b.type %></span>
                  <% if (b.sub_type) { %>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 3px;"><%= b.sub_type %></div>
                  <% } %>
                </td>
                <td style="font-size: 12px;">
                  <div>Hồi: <strong><%= b.respawn_delay %>s</strong> (<%= Math.round(b.respawn_delay/60) %> phút)</div>
                  <div style="color: var(--text-muted);">Rời: <%= b.despawn_timeout %>s | Spawn: <%= b.spawn_count %></div>
                </td>
                <td>
                  <button type="button" 
                          class="btn btn-sm <%= b.enabled ? 'btn-success' : 'btn-danger' %>" 
                          style="font-size: 11px; padding: 4px 10px; border-radius: 12px;"
                          onclick="toggleBossEnabled(<%= b.id %>, <%= b.enabled ? 0 : 1 %>)">
                    <%= b.enabled ? '✓ BẬT Spawn' : '✕ TẮT Spawn' %>
                  </button>
                </td>
                <td style="text-align: center;">
                  <div class="action-group" style="justify-content: center; gap: 5px;">
                    <button class="btn btn-sm btn-ghost" onclick="viewBossDetails(<%= b.id %>)" title="Xem Chi tiết SQL & Canvas">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      Chi tiết
                    </button>
                    <button class="btn btn-sm btn-primary" onclick="openEditBossModal(<%= b.id %>)" title="Chỉnh sửa đầy đủ Boss & Form">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      Sửa
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="deleteBossTemplate(<%= b.id %>, '<%= escapeJsString(b.name) %>')" title="Xóa Boss">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      Xóa
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">
                Chưa có dữ liệu Boss Template trong CSDL MySQL
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Section: Live Boss Shortcut -->
<div class="panel-card" style="margin-bottom: 20px;">
  <div class="panel-card-body" style="padding: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px;">
    <div>
      <h3 style="margin: 0 0 6px 0; color: var(--text-primary); font-size: 16px; display: flex; align-items: center; gap: 8px;">
        <span style="width: 10px; height: 10px; border-radius: 50%; background: #28a745; display: inline-block;"></span>
        Danh sách Boss Đang Xuất Hiện Trực Tiếp (Live Status)
      </h3>
      <p style="margin: 0; color: var(--text-muted); font-size: 13px;">
        Danh sách Boss Trực Tiếp đã được tách thành trang riêng biệt với bộ lọc nâng cao, thống kê và tính năng Tự động làm mới (Auto Refresh).
      </p>
    </div>
    <a href="/panel/admin?type=boss_live" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 13px; text-decoration: none;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Xem Trang Boss Live Trực Tiếp
    </a>
  </div>
</div>

<!-- MODAL 1: ADD BOSS TEMPLATE & FORM MODAL -->
<div id="addBossModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
  <div class="panel-card" style="width: 900px; max-width: 95vw; max-height: 92vh; overflow-y: auto; box-shadow: 0 12px 40px rgba(0,0,0,0.7);">
    <div class="panel-card-body">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; margin-bottom: 15px;">
        <h3 style="margin: 0; color: var(--primary-color); font-size: 19px;">Thêm Boss Mới (CSDL SQL Tập Trung)</h3>
        <button class="btn btn-ghost btn-sm" onclick="closeAddBossModal()" style="font-size: 18px;">✕</button>
      </div>

      <form id="addBossForm" onsubmit="submitAddBoss(event)">
        <div style="display: grid; grid-template-columns: 1fr 240px; gap: 20px; align-items: start;">
          
          <!-- Left side: Form Inputs -->
          <div>
            <h4 style="color: var(--text-primary); margin: 0 0 10px 0; font-size: 14px; border-left: 3px solid var(--primary-color); padding-left: 8px;">1. Thông tin Boss Template</h4>
            
            <div style="display: grid; grid-template-columns: 120px 1fr 1fr; gap: 10px;">
              <div class="form-group">
                <label class="form-label">ID Boss</label>
                <input type="number" class="form-input" id="add_id" name="id" placeholder="Tự tạo ID âm">
              </div>
              <div class="form-group">
                <label class="form-label">Tên Boss (*)</label>
                <input type="text" class="form-input" id="add_name" name="name" placeholder="Ví dụ: Broly Huyền Thoại" required>
              </div>
              <div class="form-group">
                <label class="form-label">Loại Boss</label>
                <select class="form-input" id="add_type" name="type">
                  <option value="NORMAL">NORMAL</option>
                  <option value="TASK">TASK</option>
                  <option value="EVENT">EVENT</option>
                  <option value="DUNGEON">DUNGEON</option>
                  <option value="PHOBAN">PHOBAN</option>
                  <option value="MINI">MINI</option>
                  <option value="FINAL">FINAL</option>
                </select>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
              <div class="form-group">
                <label class="form-label">Nhóm Boss (sub_type)</label>
                <input type="text" class="form-input" id="add_sub_type" name="sub_type" placeholder="NAPPA, TDST, CELL...">
              </div>
              <div class="form-group">
                <label class="form-label">Hành tinh (Gender)</label>
                <select class="form-input" id="add_gender" name="gender">
                  <option value="0">Trái Đất (0)</option>
                  <option value="1">Namếc (1)</option>
                  <option value="2">Xayda (2)</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Số lượng Spawn</label>
                <input type="number" class="form-input" id="add_spawn_count" name="spawn_count" min="1" value="1">
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
              <div class="form-group">
                <label class="form-label">Thời gian hồi sinh (s)</label>
                <input type="number" class="form-input" id="add_respawn_delay" name="respawn_delay" min="0" value="300">
              </div>
              <div class="form-group">
                <label class="form-label">Thời gian tự rời (s)</label>
                <input type="number" class="form-input" id="add_despawn_timeout" name="despawn_timeout" min="0" value="900">
              </div>
              <div class="form-group">
                <label class="form-label">Nhiệm vụ ID (nếu có)</label>
                <input type="number" class="form-input" id="add_require_task_id" name="require_task_id" placeholder="VD: 19, 20">
              </div>
            </div>

            <h4 style="color: var(--text-primary); margin: 15px 0 10px 0; font-size: 14px; border-left: 3px solid #28a745; padding-left: 8px;">2. Cấu hình Dạng gốc (Form 0 & Trang phục)</h4>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
              <div class="form-group">
                <label class="form-label">HP Min/Max</label>
                <input type="number" class="form-input" id="add_hp_min" name="hp_min" value="1000000" placeholder="HP">
              </div>
              <div class="form-group">
                <label class="form-label">Sát thương (Dame)</label>
                <input type="number" class="form-input" id="add_dame" name="dame" value="10000">
              </div>
              <div class="form-group">
                <label class="form-label">Tên dạng hiển thị</label>
                <input type="text" class="form-input" id="add_form_name" name="form_name" placeholder="Mặc định: Tên Boss Gốc">
              </div>
            </div>

            <!-- Disguise Selector Trigger -->
            <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 10px; border-radius: 8px; margin-bottom: 12px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 13px; font-weight: 600; color: #ffc107;">Chọn Trang Phục Theo Cải Trang (type = 5)</span>
                <button type="button" class="btn btn-warning btn-sm" onclick="openDisguiseSelectorModal('add')">
                  🔍 Chọn từ Danh sách Cải Trang
                </button>
              </div>
              <div style="font-size: 11px; color: var(--text-muted);">
                Tự động lấy ID Part Head, Body, Leg từ vật phẩm Cải trang trong `item_template`.
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
              <div class="form-group">
                <label class="form-label">Head Part ID</label>
                <input type="number" class="form-input" id="add_outfit_head" name="outfit_head" value="-1" onchange="triggerAddCanvasUpdate()">
              </div>
              <div class="form-group">
                <label class="form-label">Body Part ID</label>
                <input type="number" class="form-input" id="add_outfit_body" name="outfit_body" value="-1" onchange="triggerAddCanvasUpdate()">
              </div>
              <div class="form-group">
                <label class="form-label">Leg Part ID</label>
                <input type="number" class="form-input" id="add_outfit_leg" name="outfit_leg" value="-1" onchange="triggerAddCanvasUpdate()">
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
              <div class="form-group">
                <label class="form-label">Bag Part</label>
                <input type="number" class="form-input" id="add_outfit_bag" name="outfit_bag" value="-1">
              </div>
              <div class="form-group">
                <label class="form-label">Aura Part</label>
                <input type="number" class="form-input" id="add_outfit_aura" name="outfit_aura" value="-1">
              </div>
              <div class="form-group">
                <label class="form-label">Eff Part</label>
                <input type="number" class="form-input" id="add_outfit_eff" name="outfit_eff" value="-1">
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <div class="form-group">
                <label class="form-label">Câu thoại xuất hiện (Start)</label>
                <input type="text" class="form-input" id="add_text_start" name="text_start" placeholder="Ví dụ: Ta sẽ hủy diệt thế giới!">
              </div>
              <div class="form-group">
                <label class="form-label">Câu thoại giao chiến (Mid)</label>
                <input type="text" class="form-input" id="add_text_mid" name="text_mid" placeholder="Ví dụ: Đỡ lấy chiêu này!">
              </div>
            </div>

            <div style="display: flex; gap: 15px; margin-top: 10px;">
