        <div style="margin-top: 20px; border-top: 1px solid var(--border-color); padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
          <button type="button" class="btn btn-danger" onclick="confirmDeleteCurrentBoss()" style="font-size: 13px;">
            🗑 Xóa Boss Này
          </button>
          <div style="display: flex; gap: 10px;">
            <button type="button" class="btn btn-ghost" onclick="closeEditBossModal()">Hủy</button>
            <button type="submit" class="btn btn-primary" style="padding: 8px 20px; font-weight: 600;">Lưu Cấu Hình SQL</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL 3: VIEW BOSS DETAILS & CANVAS PREVIEW MODAL -->
<div id="bossDetailsModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
  <div class="panel-card" style="width: 850px; max-width: 95vw; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.6);">
    <div class="panel-card-body" id="bossDetailsContent">
      <div style="text-align: center; padding: 40px; color: var(--text-muted);">Đang tải chi tiết từ CSDL MySQL...</div>
    </div>
  </div>
</div>

<!-- MODAL 4: DISGUISE (CẢI TRANG type = 5) SELECTOR MODAL -->
<div id="disguiseSelectorModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 10005; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
  <div class="panel-card" style="width: 650px; max-width: 92vw; max-height: 85vh; overflow-y: auto; box-shadow: 0 12px 35px rgba(0,0,0,0.7);">
    <div class="panel-card-body">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; margin-bottom: 12px;">
        <h3 style="margin: 0; color: #ffc107; font-size: 17px;">Danh sách Cải Trang (item_template type = 5)</h3>
        <button class="btn btn-ghost btn-sm" onclick="closeDisguiseSelectorModal()" style="font-size: 18px;">✕</button>
      </div>

      <div class="search-box" style="margin-bottom: 12px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="form-input" placeholder="Tìm tên hoặc ID Cải trang..." id="disguiseSearchInput" onkeyup="filterDisguiseItems()">
      </div>

      <div style="max-height: 450px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px;">
        <table class="admin-table" style="font-size: 13px;">
          <thead>
            <tr>
              <th style="width: 50px;">Icon</th>
              <th>ID & Tên Cải Trang</th>
              <th>Part (Head / Body / Leg)</th>
              <th style="text-align: right; width: 80px;">Chọn</th>
            </tr>
          </thead>
          <tbody id="disguiseTableBody">
            <% if (disguiseList && disguiseList.length > 0) { %>
              <% disguiseList.forEach(function(item) { %>
                <tr class="disguise-row" data-name="<%= (item.name || '').toLowerCase() %>" data-id="<%= item.id %>">
                  <td>
                    <img src="/api/icon/<%= item.icon_id %>.png" onError="this.src='/api/icon-x2/<%= item.icon_id %>.png'" style="width: 32px; height: 32px; object-fit: contain;">
                  </td>
                  <td>
                    <div style="font-weight: 600; color: var(--primary-color);"><%= item.name %></div>
                    <div style="font-size: 11px; color: var(--text-muted);">Item ID: <%= item.id %></div>
                  </td>
                  <td style="font-family: 'JetBrains Mono', monospace; font-size: 12px;">
                    H: <strong><%= item.head %></strong> | B: <strong><%= item.body %></strong> | L: <strong><%= item.leg %></strong>
                  </td>
                  <td style="text-align: right;">
                    <button type="button" class="btn btn-warning btn-sm" onclick="selectDisguiseItem(<%= item.head %>, <%= item.body %>, <%= item.leg %>, '<%= escapeJsString(item.name) %>')">
                      Chọn
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="4" style="text-align: center; padding: 25px; color: var(--text-muted);">Không tìm thấy dữ liệu Cải Trang (type = 5) trong item_template</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 12px; text-align: right;">
        <button class="btn btn-ghost" onclick="closeDisguiseSelectorModal()">Đóng</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL 5: BOSS ITEM OPTION BUILDER MODAL -->
<div id="bossOptionModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 10010; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
  <div class="panel-card" style="width: 580px; max-width: 92vw; max-height: 85vh; overflow-y: auto; box-shadow: 0 12px 35px rgba(0,0,0,0.7);">
    <div class="panel-card-body">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 12px;">
        <h3 style="margin: 0; color: #28a745; font-size: 16px;" id="bossOptionModalTitle">Cấu Hình Option Cho Vật Phẩm</h3>
        <button type="button" class="btn btn-ghost btn-sm" onclick="closeBossOptionModal()" style="font-size: 18px;">✕</button>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 120px 80px; gap: 8px; align-items: end; margin-bottom: 12px;">
        <div>
          <label class="form-label" style="font-size: 12px; font-weight: 600;">Option từ item_option_template</label>
          <input type="text" class="form-input" id="bossOptionFilter" placeholder="Tìm option..." oninput="filterBossOptionCombo(this.value)" style="font-size: 11px; padding: 4px 8px; margin-bottom: 4px;">
          <select class="form-input" id="bossOptionSelect" style="font-size: 12px; padding: 6px;">
            <option value="">-- Chọn Option --</option>
            <% if (typeof itemOptionTemplates !== 'undefined' && itemOptionTemplates && itemOptionTemplates.length > 0) { %>
              <% itemOptionTemplates.forEach(function(opt) { %>
                <option value="<%= opt.id %>">[ID <%= opt.id %>] <%= opt.name %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div>
          <label class="form-label" style="font-size: 12px; font-weight: 600;">Chỉ số (param)</label>
          <input type="number" step="1" class="form-input" id="bossOptionParam" value="0" style="font-size: 12px; padding: 6px;">
        </div>
        <div>
          <button type="button" class="btn btn-primary btn-sm" onclick="addBossOptionToTempList()" style="width: 100%; font-size: 12px; padding: 8px 0;">+ Thêm</button>
        </div>
      </div>

      <div style="max-height: 250px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 6px; margin-bottom: 15px;">
        <table class="admin-table" style="font-size: 12px;">
          <thead>
            <tr>
              <th style="width: 50px;">ID</th>
              <th>Tên Option</th>
              <th style="width: 110px;">Chỉ Số (Param)</th>
              <th style="text-align: center; width: 60px;">Xóa</th>
            </tr>
          </thead>
          <tbody id="bossOptionTableBody">
            <tr><td colspan="4" style="text-align: center; color: var(--text-muted); padding: 15px;">Chưa có option nào được thêm</td></tr>
          </tbody>
        </table>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="btn btn-ghost" onclick="closeBossOptionModal()">Hủy</button>
        <button type="button" class="btn btn-success" onclick="saveBossOptionsToItem()">Áp Dụng Option</button>
      </div>
    </div>
  </div>
</div>

<%
  function formatNumber(num) {
    if (!num) return '0';
    return new Intl.NumberFormat('vi-VN').format(num);
  }
  function escapeJsString(str) {
    if (!str) return '';
    return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
  }
%>

<script>
  var currentDisguiseTarget = 'add'; // 'add' or 'edit'

  function updateCustomId() {
    var select = document.getElementById('bossSelect');
    var input = document.getElementById('customBossId');
    if (select.value) {
      input.value = select.value;
    }
  }

  async function spawnBoss() {
    var bossId = document.getElementById('customBossId').value;
    if (!bossId) {
      showToast('Vui lòng chọn hoặc nhập Boss ID', 'error');
      return;
    }
    
    if (!confirm('Bạn có chắc chắn muốn gọi Boss mang ID ' + bossId + ' vào game?')) {
      return;
    }

    var result = await adminApi('spawn-boss', { bossId: bossId });
    if (result.success) {
      showToast(result.message, 'success');
      document.getElementById('bossSelect').value = '';
      document.getElementById('customBossId').value = '';
    } else {
      showToast(result.message || 'Lỗi gửi lệnh', 'error');
    }
  }

  function filterBossTable() {
    var search = (document.getElementById('bossSearchInput').value || '').toLowerCase().trim();
    var typeFilter = document.getElementById('bossTypeFilter').value;
    var statusFilter = document.getElementById('bossStatusFilter').value;

    var rows = document.querySelectorAll('.boss-row');
    var visibleCount = 0;

    rows.forEach(function(row) {
      var name = row.getAttribute('data-name');
      var id = row.getAttribute('data-id');
      var subtype = row.getAttribute('data-subtype');
      var type = row.getAttribute('data-type');
      var enabled = row.getAttribute('data-enabled');

      var matchesSearch = !search || name.includes(search) || id.includes(search) || subtype.includes(search);
      var matchesType = !typeFilter || type === typeFilter;
      var matchesStatus = !statusFilter || enabled === statusFilter;

      if (matchesSearch && matchesType && matchesStatus) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    document.getElementById('visibleBossCount').textContent = visibleCount;
  }

  async function toggleBossEnabled(bossId, newEnabledState) {
    var actionText = newEnabledState ? 'BẬT' : 'TẮT';
    if (!confirm('Bạn có muốn ' + actionText + ' trạng thái Spawn của Boss ID ' + bossId + '?')) return;

    var result = await adminApi('toggle-boss-enabled', { bossId: bossId, enabled: newEnabledState });
    if (result.success) {
      showToast(result.message, 'success');
      setTimeout(function() { location.reload(); }, 600);
    } else {
      showToast(result.message || 'Lỗi cập nhật', 'error');
    }
  }

  async function deleteBossTemplate(bossId, bossName) {
    if (!confirm('XÁC NHẬN XÓA: Bạn có chắc chắn muốn xóa hẳn Boss "' + bossName + '" (ID: ' + bossId + ') khỏi CSDL MySQL?')) {
      return;
    }
    var result = await adminApi('delete-boss-template', { bossId: bossId });
    if (result.success) {
      showToast(result.message, 'success');
      setTimeout(function() { location.reload(); }, 600);
    } else {
      showToast(result.message || 'Lỗi xóa Boss', 'error');
    }
  }

  function confirmDeleteCurrentBoss() {
    var bossId = document.getElementById('edit_id').value;
    var bossName = document.getElementById('edit_name').value;
    if (bossId) {
      deleteBossTemplate(bossId, bossName);
    }
  }

  /* MAP SPAWN MANAGEMENT SYSTEM */
  var addBossMapList = [];
  var editBossMapList = [];
  var mapTemplateDict = {};
  <% if (typeof mapList !== 'undefined' && mapList.length > 0) { %>
    <% mapList.forEach(function(m) { %>
      mapTemplateDict[<%= m.id %>] = "<%= escapeJsString(m.name) %>";
    <% }); %>
  <% } %>

  /* BOSS REWARD & OPTION MANAGEMENT SYSTEM */
  function escapeBossHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeJsString(str) {
    return escapeBossHtml(str);
  }

  var addBossRewardList = [];
  var editBossRewardList = [];

  var itemTemplateList = <%- JSON.stringify(typeof itemTemplates !== 'undefined' && itemTemplates ? itemTemplates : []).replace(/</g, '\\u003c') %>;
  var itemTemplateDict = {};
  itemTemplateList.forEach(function(it) { itemTemplateDict[it.id] = it; });

  var itemOptionList = <%- JSON.stringify(typeof itemOptionTemplates !== 'undefined' && itemOptionTemplates ? itemOptionTemplates : []).replace(/</g, '\\u003c') %>;
  var itemOptionDict = {};
  itemOptionList.forEach(function(opt) { itemOptionDict[opt.id] = opt.name; });

  var currentOptionTargetContext = 'add'; // 'add' or 'edit'
  var currentOptionItemIndex = -1;
  var tempBossOptions = [];

  function filterRewardItemCombo(targetPrefix, filterText) {
    var select = document.getElementById(targetPrefix + '_reward_item_id');
    if (!select) return;
    var search = (filterText || '').toLowerCase().trim();
    var html = '<option value="">-- Chọn Item --</option>';
    itemTemplateList.forEach(function(it) {
      var name = (it.name || '').toLowerCase();
      var idStr = String(it.id);
      if (!search || name.includes(search) || idStr.includes(search)) {
        html += '<option value="' + it.id + '">[ID ' + it.id + '] ' + escapeBossHtml(it.name) + '</option>';
      }
    });
    select.innerHTML = html;
  }

  function filterBossOptionCombo(filterText) {
    var select = document.getElementById('bossOptionSelect');
    if (!select) return;
    var search = (filterText || '').toLowerCase().trim();
    var html = '<option value="">-- Chọn Option --</option>';
    itemOptionList.forEach(function(opt) {
      var name = (opt.name || '').toLowerCase();
      var idStr = String(opt.id);
      if (!search || name.includes(search) || idStr.includes(search)) {
        html += '<option value="' + opt.id + '">[ID ' + opt.id + '] ' + escapeBossHtml(opt.name) + '</option>';
      }
    });
    select.innerHTML = html;
  }

  function openBossOptionModal(targetContext, itemIndex) {
    currentOptionTargetContext = targetContext;
    currentOptionItemIndex = itemIndex;

    var rewardList = targetContext === 'add' ? addBossRewardList : editBossRewardList;
    var rewardItem = rewardList[itemIndex];
    if (!rewardItem) return;

    var itemInfo = itemTemplateDict[rewardItem.item_id] || { name: 'Item #' + rewardItem.item_id };
    document.getElementById('bossOptionModalTitle').textContent = 'Option cho: ' + itemInfo.name + ' (ID: ' + rewardItem.item_id + ')';

    var opts = rewardItem.item_options;
    if (typeof opts === 'string') {
      try { opts = JSON.parse(opts); } catch(e) { opts = []; }
    }
    tempBossOptions = (opts || []).map(function(o) { return { id: Number(o.id), param: Number(o.param) }; });

    document.getElementById('bossOptionFilter').value = '';
    filterBossOptionCombo('');
    document.getElementById('bossOptionParam').value = '0';
    renderBossOptionRows();

    document.getElementById('bossOptionModal').style.display = 'flex';
  }

  function closeBossOptionModal() {
    document.getElementById('bossOptionModal').style.display = 'none';
  }

  function renderBossOptionRows() {
    var tbody = document.getElementById('bossOptionTableBody');
    if (!tbody) return;

    if (tempBossOptions.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; color: var(--text-muted); padding: 15px;">Chưa có option nào được thêm</td></tr>';
      return;
    }

    var html = '';
    tempBossOptions.forEach(function(opt, idx) {
      var optName = itemOptionDict[opt.id] || ('Option ID ' + opt.id);
      html += '<tr>';
      html += '<td style="font-family: \'JetBrains Mono\', monospace; font-weight: 600;">' + opt.id + '</td>';
      html += '<td style="font-weight: 500;">' + escapeJsString(optName) + '</td>';
      html += '<td><input type="number" class="form-input" style="padding: 3px 6px; font-size: 12px; width: 90px;" value="' + opt.param + '" onchange="updateBossOptionParam(' + idx + ', this.value)"></td>';
      html += '<td style="text-align: center;"><button type="button" class="btn btn-ghost btn-sm" style="color: #ff6b6b;" onclick="removeBossOptionFromTempList(' + idx + ')">✕</button></td>';
      html += '</tr>';
    });
    tbody.innerHTML = html;
  }

  function addBossOptionToTempList() {
    var select = document.getElementById('bossOptionSelect');
    var optId = Number(select.value);
    var param = Number(document.getElementById('bossOptionParam').value);

    if (!Number.isInteger(optId) || optId < 0) {
      showToast('Vui lòng chọn Option hợp lệ!', 'warning');
      return;
    }
    if (isNaN(param)) param = 0;

    tempBossOptions.push({ id: optId, param: param });
    renderBossOptionRows();
    select.value = '';
    document.getElementById('bossOptionParam').value = '0';
  }

  function updateBossOptionParam(index, val) {
    var p = Number(val);
    if (!isNaN(p) && tempBossOptions[index]) {
      tempBossOptions[index].param = p;
    }
  }

  function removeBossOptionFromTempList(index) {
    tempBossOptions.splice(index, 1);
    renderBossOptionRows();
  }

  function saveBossOptionsToItem() {
    var rewardList = currentOptionTargetContext === 'add' ? addBossRewardList : editBossRewardList;
    if (rewardList[currentOptionItemIndex]) {
      rewardList[currentOptionItemIndex].item_options = tempBossOptions.map(function(o) {
        return { id: Number(o.id), param: Number(o.param) };
      });
    }
    closeBossOptionModal();
    if (currentOptionTargetContext === 'add') {
      renderAddRewardRows();
    } else {
      renderEditRewardRows();
    }
  }

  function renderAddRewardRows() {
    var tbody = document.getElementById('add_reward_rows');
    if (!tbody) return;

    if (addBossRewardList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 12px;">Chưa chọn vật phẩm rớt nào</td></tr>';
      return;
    }

    var html = '';
    addBossRewardList.forEach(function(r, idx) {
      var itemInfo = itemTemplateDict[r.item_id] || { name: 'Item #' + r.item_id, icon_id: null };
      var iconHtml = itemInfo.icon_id != null ? '<img src="/api/icon/' + itemInfo.icon_id + '.png" onError="this.src=\'/api/icon-x2/' + itemInfo.icon_id + '.png\'" style="width: 20px; height: 20px; vertical-align: middle; margin-right: 4px;">' : '';
      
      var opts = r.item_options;
      if (typeof opts === 'string') { try { opts = JSON.parse(opts); } catch(e) { opts = []; } }
      var optCount = Array.isArray(opts) ? opts.length : 0;
      var optSummary = optCount > 0 ? opts.map(function(o) {
        return (itemOptionDict[o.id] || ('#' + o.id)) + ': +' + o.param;
      }).join(', ') : 'Chưa có option';

      html += '<tr>';
      html += '<td>' + (idx + 1) + '</td>';
      html += '<td><div>' + iconHtml + '<strong>' + escapeJsString(itemInfo.name) + '</strong> <small style="color: var(--text-muted);">(ID: ' + r.item_id + ')</small></div></td>';
      html += '<td>' + r.quantity_min + (r.quantity_max > r.quantity_min ? (' ~ ' + r.quantity_max) : '') + '</td>';
      html += '<td style="color: #28a745; font-weight: 600;">' + r.rate + '%</td>';
      html += '<td>';
      html += '<div style="display: flex; align-items: center; gap: 6px;">';
      html += '<span class="badge" title="' + escapeJsString(optSummary) + '" style="font-size: 10px;">' + optCount + ' option</span>';
      html += '<button type="button" class="btn btn-ghost btn-sm" style="font-size: 10px; padding: 2px 5px;" onclick="openBossOptionModal(\'add\', ' + idx + ')">⚙ Option</button>';
      html += '</div>';
      html += '</td>';
      html += '<td style="text-align: center;"><button type="button" class="btn btn-ghost btn-sm" style="color: #ff6b6b;" onclick="removeRewardFromAddList(' + idx + ')">✕</button></td>';
      html += '</tr>';
    });
    tbody.innerHTML = html;
  }

  function addRewardToAddList() {
    var select = document.getElementById('add_reward_item_id');
    var itemId = Number(select.value);
    var qMin = Number(document.getElementById('add_reward_q_min').value) || 1;
    var qMax = Number(document.getElementById('add_reward_q_max').value) || qMin;
    var rate = Number(document.getElementById('add_reward_rate').value) || 100;
    var evPt = Number(document.getElementById('add_reward_event_point').value) || 0;
    var actPt = Number(document.getElementById('add_reward_active_point').value) || 0;

    if (!Number.isInteger(itemId) || itemId <= 0) {
      showToast('Vui lòng chọn vật phẩm rớt hợp lệ!', 'warning');
      return;
    }

    addBossRewardList.push({
      item_id: itemId,
      quantity_min: qMin,
      quantity_max: qMax,
      rate: rate,
      event_point: evPt,
      active_point: actPt,
      item_options: []
    });

    renderAddRewardRows();
    select.value = '';
  }

  function removeRewardFromAddList(index) {
    addBossRewardList.splice(index, 1);
    renderAddRewardRows();
  }

  function renderEditRewardRows() {
    var tbody = document.getElementById('edit_reward_rows');
    if (!tbody) return;

    if (editBossRewardList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 12px;">Chưa chọn vật phẩm rớt nào</td></tr>';
      return;
    }

    var html = '';
    editBossRewardList.forEach(function(r, idx) {
      var itemInfo = itemTemplateDict[r.item_id] || { name: r.item_name || ('Item #' + r.item_id), icon_id: r.icon_id || null };
      var iconId = itemInfo.icon_id || r.icon_id;
      var iconHtml = iconId != null ? '<img src="/api/icon/' + iconId + '.png" onError="this.src=\'/api/icon-x2/' + iconId + '.png\'" style="width: 20px; height: 20px; vertical-align: middle; margin-right: 4px;">' : '';

      var opts = r.item_options;
      if (typeof opts === 'string') { try { opts = JSON.parse(opts); } catch(e) { opts = []; } }
      var optCount = Array.isArray(opts) ? opts.length : 0;
      var optSummary = optCount > 0 ? opts.map(function(o) {
        return (itemOptionDict[o.id] || ('#' + o.id)) + ': +' + o.param;
      }).join(', ') : 'Chưa có option';

      html += '<tr>';
      html += '<td>' + (idx + 1) + '</td>';
      html += '<td><div>' + iconHtml + '<strong>' + escapeJsString(itemInfo.name) + '</strong> <small style="color: var(--text-muted);">(ID: ' + r.item_id + ')</small></div></td>';
      html += '<td><div style="display: flex; gap: 3px; align-items: center;"><input type="number" min="1" class="form-input" style="width: 50px; padding: 2px 4px; font-size: 11px;" value="' + r.quantity_min + '" onchange="updateEditRewardQMin(' + idx + ', this.value)">~<input type="number" min="1" class="form-input" style="width: 50px; padding: 2px 4px; font-size: 11px;" value="' + r.quantity_max + '" onchange="updateEditRewardQMax(' + idx + ', this.value)"></div></td>';
