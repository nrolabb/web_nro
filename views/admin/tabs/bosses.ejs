  /* FULL EDIT BOSS MODAL SYSTEM */
  var currentEditBossData = null;

  async function openEditBossModal(bossId) {
    var modal = document.getElementById('editBossModal');
    modal.style.display = 'flex';
    document.getElementById('editBossTitle').textContent = 'Đang tải dữ liệu Boss ID ' + bossId + '...';

    var result = await adminApi('get-boss-details', { bossId: bossId });
    if (!result.success || !result.boss) {
      showToast(result.message || 'Lỗi tải dữ liệu Boss', 'error');
      closeEditBossModal();
      return;
    }

    currentEditBossData = result.boss;
    var t = result.boss.template;
    var forms = result.boss.forms || [];

    // Load Maps for Edit
    editBossMapList = (result.boss.maps || []).map(function(m) {
      return { map_id: m.map_id, zone_id: m.zone_id };
    });
    renderEditMapBadges();

    // Load Rewards for Edit
    editBossRewardList = (result.boss.rewards || []).map(function(r) {
      var opts = r.item_options;
      if (typeof opts === 'string') {
        try { opts = JSON.parse(opts); } catch(e) { opts = []; }
      }
      return {
        id: r.id,
        boss_id: r.boss_id,
        item_id: r.item_id,
        item_name: r.item_name,
        icon_id: r.icon_id,
        quantity_min: r.quantity_min || 1,
        quantity_max: r.quantity_max || r.quantity_min || 1,
        rate: r.rate !== undefined ? r.rate : 100,
        event_point: r.event_point || 0,
        active_point: r.active_point || 0,
        item_options: Array.isArray(opts) ? opts : []
      };
    });
    renderEditRewardRows();

    // 1. Populate Boss Template Fields
    document.getElementById('edit_id').value = t.id;
    document.getElementById('edit_name').value = t.name || '';
    document.getElementById('edit_type').value = t.type || 'NORMAL';
    document.getElementById('edit_sub_type').value = t.sub_type || '';
    document.getElementById('edit_gender').value = t.gender !== undefined ? t.gender : 0;
    document.getElementById('edit_spawn_count').value = t.spawn_count || 1;
    document.getElementById('edit_respawn_delay').value = t.respawn_delay || 300;
    document.getElementById('edit_despawn_timeout').value = t.despawn_timeout || 900;
    document.getElementById('edit_require_task_id').value = t.require_task_id || '';
    document.getElementById('edit_enabled').checked = !!t.enabled;
    document.getElementById('edit_is_notify').checked = !!t.is_notify;
    document.getElementById('edit_is_zone_0_1_disabled').checked = !!t.is_zone_0_1_disabled;

    // 2. Render Form Tabs if multiple forms exist
    var tabsContainer = document.getElementById('editFormTabsContainer');
    if (forms.length > 1) {
      var tabsHtml = '';
      forms.forEach(function(f, idx) {
        tabsHtml += '<button type="button" class="btn btn-sm ' + (idx === 0 ? 'btn-primary' : 'btn-ghost') + '" onclick="switchEditForm(' + idx + ')" id="formTab_' + idx + '" style="font-size: 11px; padding: 2px 8px;">Dạng ' + (f.form_order !== undefined ? f.form_order : idx) + '</button>';
      });
      tabsContainer.innerHTML = tabsHtml;
    } else {
      tabsContainer.innerHTML = '<span style="font-size: 11px; color: var(--text-muted);">(Dạng 0 Mặc định)</span>';
    }

    // 3. Load Form 0 initially
    switchEditForm(0);

    // 4. Render Sub-components summary (Maps, Skills, Rewards)
    renderEditSubComponentsSummary(result.boss);

    document.getElementById('editBossTitle').textContent = 'Chỉnh sửa Boss: ' + t.name + ' (ID: ' + t.id + ')';
  }

  function switchEditForm(index) {
    if (!currentEditBossData || !currentEditBossData.forms) return;
    var forms = currentEditBossData.forms;
    var f = forms[index] || forms[0] || {};

    // Update active tab button highlight
    forms.forEach(function(item, idx) {
      var btn = document.getElementById('formTab_' + idx);
      if (btn) {
        if (idx === index) {
          btn.className = 'btn btn-sm btn-primary';
        } else {
          btn.className = 'btn btn-sm btn-ghost';
        }
      }
    });

    document.getElementById('edit_form_id').value = f.id || '';
    document.getElementById('edit_form_name').value = f.name || (currentEditBossData.template ? currentEditBossData.template.name : '');
    document.getElementById('edit_hp_min').value = f.hp_min !== undefined ? f.hp_min : 1000000;
    document.getElementById('edit_hp_max').value = f.hp_max !== undefined ? f.hp_max : (f.hp_min !== undefined ? f.hp_min : 1000000);
    document.getElementById('edit_dame').value = f.dame !== undefined ? f.dame : 10000;
    document.getElementById('edit_outfit_head').value = f.outfit_head !== undefined ? f.outfit_head : -1;
    document.getElementById('edit_outfit_body').value = f.outfit_body !== undefined ? f.outfit_body : -1;
    document.getElementById('edit_outfit_leg').value = f.outfit_leg !== undefined ? f.outfit_leg : -1;
    document.getElementById('edit_outfit_bag').value = f.outfit_bag !== undefined ? f.outfit_bag : -1;
    document.getElementById('edit_outfit_aura').value = f.outfit_aura !== undefined ? f.outfit_aura : -1;
    document.getElementById('edit_outfit_eff').value = f.outfit_eff !== undefined ? f.outfit_eff : -1;
    document.getElementById('edit_text_start').value = f.text_start || '';
    document.getElementById('edit_text_mid').value = f.text_mid || '';
    document.getElementById('edit_text_end').value = f.text_end || '';

    setTimeout(function() { triggerEditCanvasUpdate(); }, 80);
  }

  function renderEditSubComponentsSummary(boss) {
    var container = document.getElementById('editSubComponentsSummary');
    if (!container) return;

    var maps = boss.maps || [];
    var skills = boss.skills || [];
    var rewards = boss.rewards || [];

    var mapsText = maps.length > 0 ? maps.map(function(m) { return (m.map_name || ('Map ' + m.map_id)); }).join(', ') : 'Tất cả map';
    var skillsText = skills.length > 0 ? skills.map(function(s) { return (s.skill_name || ('Skill ' + s.skill_id)) + ' (Cấp ' + s.skill_level + ')'; }).join(', ') : 'Không';
    var rewardsText = rewards.length > 0 ? rewards.map(function(r) { return (r.item_name || ('Item ' + r.item_id)) + ' (' + r.rate + '%)'; }).join(', ') : 'Không';

    container.innerHTML = `
      <div style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); padding: 10px; border-radius: 8px; font-size: 11px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
        <div><strong style="color: #17a2b8;">🗺️ Maps spawn (${maps.length}):</strong><br><span style="color: var(--text-muted);">${mapsText}</span></div>
        <div><strong style="color: #ffc107;">⚡ Chiêu thức (${skills.length}):</strong><br><span style="color: var(--text-muted);">${skillsText}</span></div>
        <div><strong style="color: #28a745;">🎁 Vật phẩm rớt (${rewards.length}):</strong><br><span style="color: var(--text-muted);">${rewardsText}</span></div>
      </div>
    `;
  }

