  <p>Sao chép mã và nhập Giftcode trong game để nhận quà.</p>
  <p id="serverGiftcodeNotice"></p>
  <label id="serverGiftcodeCharacterLabel" hidden>Nhân vật <select id="serverGiftcodeCharacter"></select></label>
  <div id="serverGiftcodeList"></div>
  <p id="serverGiftcodeStatus" role="status" aria-live="polite"></p>
  <button type="button" id="serverGiftcodeRefresh">Làm mới</button>
 </section>
</div>
